?start: program

program: statement*

?statement: variable_declaration
          | variable_assignment
          | function_declaration
          | type_declaration
          | class_declaration
          | interface_declaration
          | if_statement
          | for_statement
          | while_statement
          | try_statement
          | match_statement
          | return_statement
          | throw_statement
          | expression_statement
          | import_statement

// Module System
import_statement: IMPORT dotted_name

dotted_name: IDENTIFIER (DOT IDENTIFIER)*

// Variable Declaration
variable_declaration: DEF target_expression type EQUALS expression
variable_assignment: target_expression ASSIGN expression


target_expression: IDENTIFIER
                | THIS
                | SUPER
                 | IDENTIFIER property_access
                 | THIS property_access  
                 | SUPER property_access


// Function Declaration
function_declaration: FUNC IDENTIFIER LPAR parameter_list? RPAR type? function_body END
parameter_list: parameter (COMMA parameter)*
parameter: IDENTIFIER type
function_body: statement*




// Type Declaration
type_declaration: TYPE IDENTIFIER type_body END
              | TYPE IDENTIFIER extends_clause type_body END

type_body: type_field*
type_field: IDENTIFIER type

// Class Declaration
class_declaration: CLASS IDENTIFIER extends_clause? implements_clause? class_body END
extends_clause: EXTENDS IDENTIFIER (COMMA IDENTIFIER)*
implements_clause: IMPLEMENTS IDENTIFIER (COMMA IDENTIFIER)*

class_body: class_member*
class_member: access_modifier? STATIC? OVERRIDE? (property_declaration | method_declaration)
            | access_modifier? constructor_declaration

access_modifier: PUBLIC | PRIVATE | PROTECTED

property_declaration: IDENTIFIER type (EQUALS expression)?

method_declaration: FUNC IDENTIFIER LPAR parameter_list? RPAR type function_body END

constructor_declaration: CONSTRUCTOR LPAR parameter_list? RPAR function_body END

// Interface Declaration
interface_declaration: INTERFACE IDENTIFIER interface_body END
interface_body: interface_member*
interface_member: FUNC IDENTIFIER LPAR parameter_list? RPAR type

// Control Flow
if_statement: IF_KW DOLLAR expression DOLLAR DO_KW statement* elif_clause* else_clause? END
elif_clause: ELSE_IF DOLLAR expression DOLLAR DO_KW statement*
else_clause: ELSE_KW DO_KW statement*

for_statement: FOR_KW DEF IDENTIFIER type IN_KW expression DO_KW statement* END

while_statement: WHILE_KW DOLLAR expression DOLLAR DO_KW statement* END

// Error Handling
try_statement: TRY_KW statement* catch_clause* finally_clause? END
catch_clause: CATCH_KW IDENTIFIER type DO_KW statement*
finally_clause: FINALLY_KW DO_KW statement* 

// Pattern Matching
match_statement: MATCH_KW expression case_clause* default_clause? END
case_clause: CASE_KW pattern guard? DO_KW statement*
default_clause: DEFAULT_KW DO_KW statement*
pattern: literal
       | IDENTIFIER
       | type IDENTIFIER
       | array_pattern
       | object_pattern
       | map_pattern
       | tuple_pattern
       | empty_object_pattern
       | empty_map_pattern
guard: IF_KW DOLLAR expression DOLLAR
pattern_list: pattern (COMMA pattern)*
tuple_pattern: LPAR pattern_list? RPAR
object_pattern: LBRACE dict_pattern_entries RBRACE
map_pattern: LBRACE map_pattern_entries RBRACE
dict_pattern_entries: dict_pattern_entry (COMMA dict_pattern_entry)*
dict_pattern_entry: IDENTIFIER COLON pattern
map_pattern_entries: map_pattern_entry (COMMA map_pattern_entry)*
map_pattern_entry: pattern ARROW_OP pattern
empty_object_pattern: LBRACE UNDERSCORE RBRACE
empty_map_pattern: LBRACE UNDERSCORE ARROW_OP UNDERSCORE RBRACE
array_pattern: LBRACKET pattern_list? RBRACKET

// Statements
return_statement: RETURN_KW expression?
throw_statement: THROW_KW expression
expression_statement: expression
spawn_statement: SPAWN_KW expression

// Expressions
?expression: or_expression

?or_expression: and_expression
              | or_expression OR_OP and_expression

?and_expression: equality_expression
               | and_expression AND_OP equality_expression

?equality_expression: relational_expression
                    | equality_expression equality_op relational_expression

equality_op: EQUAL_TO | NOT_EQUAL_TO

?relational_expression: additive_expression
                     | relational_expression relational_op additive_expression

relational_op: LESS_THAN | GREATER_THAN | LESS_THAN_OR_EQUAL_TO | GREATER_THAN_OR_EQUAL_TO

?additive_expression: multiplicative_expression
                   | additive_expression PLUS multiplicative_expression
                   | additive_expression MINUS multiplicative_expression

?multiplicative_expression: unary_expression
                         | multiplicative_expression TIMES unary_expression
                         | multiplicative_expression DIVIDE unary_expression
                         | multiplicative_expression MODULO unary_expression

?unary_expression: postfix_expression
                | NOT_OP unary_expression
                | MINUS unary_expression
                | PLUS unary_expression

?postfix_expression: primary_expression
                  | postfix_expression method_call
                  | postfix_expression property_access
                  | postfix_expression array_access

method_call: COLON method_name COLON LPAR argument_list? RPAR
          | COLON method_name COLON
super_method_call: SUPER COLON method_name COLON LPAR argument_list? RPAR
this_method_call: THIS COLON method_name COLON LPAR argument_list? RPAR

method_name:  IDENTIFIER
            | THIS
            | SUPER

property_access: DOT IDENTIFIER

array_access: LBRACKET expression RBRACKET

?primary_expression: literal
                  | target_expression
                  | IDENTIFIER LPAR argument_list? RPAR
                  | SUPER COLON LPAR argument_list? RPAR
                  | super_method_call
                  | THIS COLON LPAR argument_list? RPAR
                  | this_method_call
                  | method_call
                  | LPAR expression RPAR
                  | array_literal
                  | empty_object_literal
                  | empty_list_literal
                  | empty_map_literal
                  | empty_tuple_literal
                  | tuple_literal
                  | object_literal
                  | map_literal
                  | lambda_expression
                  | anonymous_function
                  | spawn_statement

// Literals
literal: BOOLEAN | INTEGER | FLOAT | STRING | CHAR

array_literal: LBRACKET argument_list? RBRACKET

map_literal: LBRACE map_entries+ RBRACE
map_entries: map_entry (COMMA map_entry)*
map_entry: expression ARROW_OP expression
empty_object_literal: LBRACE UNDERSCORE RBRACE
empty_list_literal: LBRACKET UNDERSCORE RBRACKET
empty_map_literal: LBRACE UNDERSCORE ARROW_OP UNDERSCORE RBRACE
empty_tuple_literal: LPAR UNDERSCORE RPAR
object_literal: LBRACE dict_entries+ RBRACE

dict_entries: dict_entry (COMMA dict_entry)*
dict_entry: IDENTIFIER COLON expression                    // object entry (property: value)

tuple_literal: LPAR expression COMMA expression (COMMA expression)* RPAR

lambda_expression: FUNC LPAR parameter_list? RPAR ARROW_OP expression
anonymous_function: FUNC LPAR parameter_list? RPAR type function_body END

argument_list: (expression | type) (COMMA expression | type)*

// Types
type: HASH type_specifier

type_specifier: PRIMITIVE_TYPE | array_type | map_type | tuple_type | custom_type

PRIMITIVE_TYPE: "int" | "float" | "bool" | "char" | "str" | "void" | "any"
array_type: LBRACKET type RBRACKET
map_type: LBRACE type COMMA type RBRACE
tuple_type: LPAR type (COMMA type)+ RPAR
custom_type: IDENTIFIER


// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// %                                  TOKENS                                   %
// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


// 1. Single-word Keywords (Reserved words - also high precedence)
ELSE_IF: "elif"
END: "end"
TRUE: ":T:"
FALSE: ":F:"
PUBLIC: "PUBLIC"
PRIVATE: "PRIVATE"
PROTECTED: "PROTECTED"
STATIC: "STATIC"
OVERRIDE: "OVERRIDE"
IMPORT: "import"
DEF: "DEF"
THIS: "THIS"
FUNC: "FUNC"
TYPE: "TYPE"
CLASS: "CLASS"
EXTENDS: "EXTENDS"
IMPLEMENTS: "IMPLEMENTS"
CONSTRUCTOR: "CONSTRUCTOR"
INTERFACE: "INTERFACE"
IF_KW: "if" 
DO_KW: "do" 
ELSE_KW: "else" 
FOR_KW: "for"
IN_KW: "in"
WHILE_KW: "while"
TRY_KW: "TRY"
CATCH_KW: "CATCH" 
FINALLY_KW: "FINALLY"
MATCH_KW: "MATCH"
CASE_KW: "CASE"
DEFAULT_KW: "DEFAULT"
RETURN_KW: "RETURN"
THROW_KW: "THROW"
SPAWN_KW: "SPAWN"
SUPER: "SUPER"

// 2. Multi-character Operators (Ordered by length or specificity)
ASSIGN: ":="
EQUAL_TO: "=="
NOT_EQUAL_TO: "!="
GREATER_THAN_OR_EQUAL_TO: ">="
LESS_THAN_OR_EQUAL_TO: "<="
AND_OP: "&&"
OR_OP: "||"
ARROW_OP: "->"

// 3. Single-character Operators
DOT: "."
COLON: ":"
EQUALS: "="
LPAR: "("
RPAR: ")"
LBRACKET: "["
RBRACKET: "]"
COMMA: ","
LBRACE: "{"
RBRACE: "}"
HASH: "#"
DOLLAR: "$"
PLUS: "+"
MINUS: "-"
TIMES: "*"
DIVIDE: "/"
MODULO: "%"
NOT_OP: "!"
GREATER_THAN: ">"
LESS_THAN: "<"
UNDERSCORE: "_"

// 4. Specific Literal Regexes (Ordered by specificity: FLOAT before INTEGER)
FLOAT: /[0-9]+\.[0-9]+/
INTEGER: /[0-9]+/
STRING: /"(\\.|[^"\\])*"/
CHAR: /'(\\.|[^'\\])'/

// 5. Generic Identifier (MUST be last for alphanumeric tokens)
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// 6. Boolean Literals (Using the TRUE/FALSE tokens defined above)
BOOLEAN: TRUE | FALSE

// 7. Comments and Whitespace (Ignored tokens, can be anywhere but often grouped)
COMMENT: "//" /.*/
_NL: /[\n]+/

%import common.WS
%ignore WS
%ignore COMMENT
%ignore _NL
