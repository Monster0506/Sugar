// Concurrency Example

FUNC worker_task(id #int) #void
    for DEF i #int in 5 do
        IO:PRINT:("Worker " + id + " processing task " + i)
        // Simulate work
        DEF delay #int = Random:INT:(100, 500)
    end
    IO:PRINT:("Worker " + id + " completed")
end

FUNC parallel_processing() #void
    // Spawn multiple concurrent tasks
    SPAWN FUNC() 
        worker_task(1)
    end
    
    SPAWN FUNC() 
        worker_task(2)
    end
    
    SPAWN FUNC() 
        worker_task(3)
    end
    
    IO:PRINT:("All workers spawned")
end

FUNC task_with_result() #int
    // Simulate some computation
    DEF result #int = 0
    for DEF i #int in 1000000 do
        result := result + i
    end
    RETURN result
end

FUNC concurrent_computation() #void
    // Create tasks and store their handles
    DEF task1 #Task = SPAWN FUNC() 
        RETURN task_with_result()
    end
    
    DEF task2 #Task = SPAWN FUNC() 
        RETURN task_with_result()
    end
    
    // Wait for completion and get results
    DEF result1 #int = task1:JOIN:()
    DEF result2 #int = task2:JOIN:()
    
    IO:PRINT:("Task 1 result: " + result1)
    IO:PRINT:("Task 2 result: " + result2)
end

FUNC background_monitor() #void
    SPAWN FUNC() 
        while $true$ do
            IO:PRINT:("Background monitor running...")
            // Simulate monitoring work
            DEF sleep_time #int = Random:INT:(1000, 3000)
        end
    end
end 
