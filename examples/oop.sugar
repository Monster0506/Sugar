// Object-Oriented Programming Example

TYPE Person
    name #str
    age #int
    email #str
end

INTERFACE Drawable
    FUNC draw() #void
    FUNC resize(width #int, height #int) #bool
end

CLASS Shape IMPLEMENTS Drawable
    PUBLIC x #int
    PUBLIC y #int
    PRIVATE color #str
    
    CONSTRUCTOR(x #int, y #int, color #str)
        THIS.x := x
        THIS.y := y
        THIS.color := color
    end
    
    FUNC draw() #void
        IO:PRINT:("Drawing shape at (" + THIS.x + ", " + THIS.y + ")")
    end
    
    FUNC resize(width #int, height #int) #bool
        THIS.x := THIS.x + width
        THIS.y := THIS.y + height
        RETURN true
    end
    
    PRIVATE FUNC get_color() #str
        RETURN THIS.color
    end
end

CLASS Circle EXTENDS Shape
    PRIVATE radius #float
    
    CONSTRUCTOR(x #int, y #int, radius #float, color #str)
        SUPER:(x, y, color)
        THIS.radius := radius
    end
    
    OVERRIDE FUNC draw() #void
        IO:PRINT:("Drawing circle with radius " + THIS.radius)
    end
    
    STATIC FUNC create_unit_circle() #Circle
        RETURN Circle(0, 0, 1.0, "black")
    end
end

CLASS MathUtility
    
    STATIC FUNC square(x #float) #float
        RETURN x * x
    end
    
    STATIC FUNC cube(x #float) #float
        RETURN x * x * x
    end
end

// Usage
DEF person #Person = {
    name: "John Doe",
    age: 30,
    email: "john@example.com"
}

DEF shape #Shape = Shape(10, 20, "red")
DEF circle #Circle = Circle(0, 0, 5.0, "blue")
DEF unit_circle #Circle = Circle:create_unit_circle:()

DEF area #float = Math.PI * MathUtility:square:(5.0) 
PRINT(area)