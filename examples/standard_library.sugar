// Standard Library Example

FUNC demonstrate_math() #void
    // Math operations
    DEF pi #float = Math.PI
    DEF e #float = Math.E
    DEF sqrt_result #float = Math:SQRT:(16.0)
    DEF pow_result #float = Math:POW:(2.0, 8.0)
    DEF floor_result #int = Math:FLOOR:(3.7)
    DEF ceil_result #int = Math:CEIL:(3.2)
    DEF round_result #int = Math:ROUND:(3.5)
    DEF abs_result #float = Math:ABS:(-42.0)
    
    IO:PRINT:("PI: " + pi:TO:(#str))
    IO:PRINT:("Square root of 16: " + sqrt_result:TO:(#str))
    IO:PRINT:("2^8: " + pow_result:TO:(#str))
end

FUNC demonstrate_io() #void
    // Input/Output operations
    IO:PRINT:("Hello from Sugar!")
    IO:PRINT:("Enter your name:")
    DEF name #str = IO:INPUT:("Name: ")
    IO:PRINT:("Hello, " + name + "!")
    
    // File operations
    File:WRITE:("test.txt", "Hello, Sugar!")
    DEF content #str = File:READ:("test.txt")
    IO:PRINT:("File content: " + content)
    File:WRITE:("test.txt", "\nAppended line",:T:)
    File:DELETE:("test.txt")
end

FUNC demonstrate_time() #void
    // Time operations
    DEF now #str = Time:NOW_STR:()
    DEF formatted #str = Time:FORMAT_STR:(now, Time.DEFAULT_FORMAT, "%Y-%m-%d")
    IO:PRINT:("Current date: " + formatted)
end

FUNC demonstrate_random() #void
    // Random operations
    DEF random_int #int = Random:INT:(1, 100)
    DEF random_float #float = Random:FLOAT:()
    
    DEF choices #[#str] = ["apple", "banana", "cherry", "date"]
    DEF random_choice #str = Random:CHOICE:(choices)
    
    DEF numbers #[#int] = [1, 2, 3, 4, 5]
    DEF shuffled #[#int] = Random:SHUFFLE:(numbers)
    
    IO:PRINT:("Random int: " + random_int:TO:(#str))
    IO:PRINT:("Random float: " + random_float:TO:(#str))
    IO:PRINT:("Random choice: " + random_choice:TO:(#str))
end 


demonstrate_math()
demonstrate_random()
demonstrate_time()
demonstrate_io()
