// Pattern Matching Example

FUNC describe_value(value #any) #str
    MATCH value
        CASE 0 do
            RETURN "zero"
        CASE n IF $n < 0$ do
            RETURN "negative number"
        CASE #str s do
            RETURN "string: " + s
        CASE #[#int] arr IF $arr :LENGTH:() > 3$ do
            RETURN "long array"
        CASE #[#int] arr do
            RETURN "short array"
        DEFAULT do
            RETURN "unknown type"
    end
end

FUNC process_command(command #any) #str
    MATCH command
        CASE "start" do
            RETURN "Starting application..."
        CASE "stop" do
            RETURN "Stopping application..."
        CASE "restart" do
            RETURN "Restarting application..."
        CASE #str cmd IF $cmd :LENGTH:() > 10$ do
            RETURN "Long command: " + cmd
        DEFAULT do
            RETURN "Unknown command"
    end
end

// Usage
DEF result1 #str = describe_value(0)
DEF result2 #str = describe_value(-5)
DEF result3 #str = describe_value("hello")
DEF result4 #str = describe_value([1, 2, 3, 4, 5])
DEF result5 #str = process_command("start") 
