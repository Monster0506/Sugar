// Control Flow Example

FUNC classify_number(n #int) #str
    if $n < 0$ do
        RETURN "negative"
    else if $n == 0$ do
        RETURN "zero"
    else do
        RETURN "positive"
    END if
END FUNC

FUNC sum_array(arr #[#int]) #int
    DEF total #int = 0
    for DEF num #int in arr do
        total := total + num
    END for
    RETURN total
END FUNC

FUNC countdown(n #int) #void
    while n > 0 do
        IO:PRINT:(n)
        n := n - 1
    END while
    IO:PRINT:("Blast off!")
END FUNC

FUNC find_element(arr #[#int], target #int) #int
    for DEF i #int in arr :LENGTH: do
        if $arr :GET: (i) == target$ do
            RETURN i
        END if
    END for
    RETURN -1
END FUNC

// Usage
DEF numbers #[#int] = [1, 2, 3, 4, 5]
DEF classification #str = classify_number(-5)
DEF sum #int = sum_array(numbers)
DEF index #int = find_element(numbers, 3) 
