// Error Handling Example

TYPE DivisionByZeroError EXTENDS Error
    dividend #float
    message #str
end

FUNC safe_divide(a #float, b #float) #float
    if $b == 0$ do
        THROW DivisionByZeroError(a, "Division by zero")
    end
    RETURN a / b
end

FUNC validate_age(age #int) #bool
    if $age < 0$ do
        THROW ValueError(age, "Age cannot be negative")
    elif $age > 150$ do
        THROW ValueError(age, "Age seems unrealistic")
    end
    RETURN true
end

FUNC process_data(data #str) #str
    TRY
        if $data == ""$ do
            THROW ValueError("", "Data cannot be null")
        end
        
        DEF result #str = "Processed: " + data
        RETURN result
    CATCH error #ValueError do
        IO:PRINT:("Value error: " + error.message)
        RETURN "Error occurred"
    CATCH error #DivisionByZeroError do
        IO:PRINT:("Division error: " + error.message)
        RETURN "Division error"
    FINALLY do
        IO:PRINT:("Cleanup completed")
    end
end

FUNC risky_operation() #void
    TRY
        DEF result #float = safe_divide(10.0, 0.0)
        IO:PRINT:("Result: " + result)
    CATCH error #DivisionByZeroError do
        IO:PRINT:("Caught division error: " + error.message)
    end
end

// Usage
DEF result1 #str = process_data("valid data")
DEF result2 #str = process_data("")
DEF is_valid #bool = validate_age(25) 
