CLASS Parent
    value #int
    CONSTRUCTOR(x #int)
        THIS:value := x
    end
    FUNC get() #int
        RETURN THIS:value
    end
end
CLASS Child EXTENDS Parent
    CONSTRUCTOR(x #int)
        SUPER(x)
    end
    OVERRIDE FUNC get() #int
        RETURN SUPER:get:() + 1
    end
end
DEF c #Child = Child(5)
DEF v #int = c:get:() 
