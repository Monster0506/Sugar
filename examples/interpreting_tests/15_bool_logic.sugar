DEF t #bool = 3 < 5 // true
DEF b #bool = 3 >= 3
DEF c #bool = t && b 
DEF f #bool = :F:


// OR logic
DEF d #bool = t || b // true
DEF e #bool = t || :F: // true
DEF r #bool = :F: || :F: // false

DEF g #bool = !t // false
DEF h #bool = !(3 < 2) // true

DEF i #bool = t && b || :F: // true
DEF j #bool = (t && b) || :F: // true
DEF k #bool = t && (b || :F:) // true
DEF l #bool = !t || b // true
DEF m #bool = !(t && b) // false

DEF n #bool = (3 < 5) && (2 > 1)
DEF o #bool = (3 < 5) || (2 < 1)
DEF p #bool = ((3 < 5) && (2 > 1)) || (1 == 2)
DEF q #bool = !((3 < 5) && (2 > 1)) 
