FUNC compute() #int
    Time:SLEEP:(2000)
    IO:PRINT:("Task: Starting computation...")
    Time:SLEEP:(2000)
    IO:PRINT:("Task: Computation finished.")
    RETURN 42
end

IO:PRINT:("Main: Spawning task...")
DEF t #Task = SPAWN FUNC() #int RETURN compute() end
IO:PRINT:("Main: Task spawned. Continuing execution.")

DEF r #int = t:JOIN:()
IO:PRINT:("Main: Joined task. Result is:")
IO:PRINT:(r)
