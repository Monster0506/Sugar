DEF y #str = ""
TYPE MyError EXTENDS Error
    message #str
end
FUNC risky(x #int) #int
    if $x < 0$ do
        THROW MyError("negative")
    end
    RETURN x
end
FUNC test() #void
    TRY
        TRY
            risky(-1)
        CATCH e #MyError do
            IO:PRINT:("Caught: " + e.message)
            y := "done"
            THROW e
        FINALLY do
            IO:PRINT:("Inner finally")
        end
    CATCH e #MyError do
        IO:PRINT:("Outer: " + e.message)
    FINALLY do
        IO:PRINT:("Outer finally")
        THROW MyError("fail in finally")
    end
end 
test()
