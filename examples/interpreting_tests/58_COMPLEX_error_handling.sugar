TYPE MyError EXTENDS Error
    message #str
end
FUNC risky(x #int) #int
    if $x < 0$ do
        THROW MyError("negative")
    end
    RETURN x
end
FUNC test() #str
    TRY
        TRY
            risky(-1)
        CATCH e #MyError do
            IO:PRINT:("Caught: " + e.message)
            THROW e
        FINALLY
            IO:PRINT:("Inner finally")
        end
    CATCH e #MyError do
        RETURN "Outer: " + e.message
    FINALLY
        IO:PRINT:("Outer finally")
        // Simulate error in finally
        THROW MyError("fail in finally")
    end
end 
