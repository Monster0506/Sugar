TYPE MyError EXTENDS Error
    message #str
end
FUNC risky(x #int) #int
    if $x < 0$ do
        THROW MyError("negative")
    end
    RETURN x
end
FUNC test() #str
        TRY
            risky(-1)
        CATCH e #MyError do
            IO:PRINT:("Caught: " + e.message)
            THROW e
        FINALLY do
            IO:PRINT:("Inner finally")
    end
end 
