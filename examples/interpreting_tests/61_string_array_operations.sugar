// Test 61: Comprehensive String Array Operations
// Since #str is an alias for #[#char], all array operations should work on strings

// Basic string creation and length
DEF s #str = "Hello"
DEF len #int = s :LENGTH:()

// String-specific operations (case conversion)
DEF upper_s #str = s :UPPER:
DEF lower_s #str = s :LOWER:

// Array access operations
DEF first_char #char = s :GET: (0)
DEF last_char #char = s :GET: (4)

// Array modification operations
s :ADD: ('!')
DEF len_after_add #int = s :LENGTH:()

s :INSERT: (0, 'X')
DEF first_after_insert #char = s :GET: (0)

s :SET: (1, 'Y')
DEF second_char #char = s :GET: (1)

// Search operations
DEF has_h #bool = s :CONTAINS: ('H')
DEF has_z #bool = s :CONTAINS: ('Z')
DEF h_index #int = s :INDEX_OF: ('H')
DEF z_index #int = s :INDEX_OF: ('Z')

// Array manipulation
DEF copy #str = "abc"
copy :REVERSE:
DEF reversed_first #char = copy :GET: (0)

// Remove operation
DEF test_remove #str = "test"
test_remove :REMOVE: (0)
DEF after_remove_first #char = test_remove :GET: (0)

// Multiple operations on same string
DEF multi #str = "world"
multi :ADD: ('!')
multi :INSERT: (0, 'H')
multi :SET: (1, 'e')
DEF final_length #int = multi :LENGTH:()
DEF final_string #str = multi
