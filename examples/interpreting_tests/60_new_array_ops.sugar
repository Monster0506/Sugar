DEF arr #[#int] = [1, 2, 3, 4, 5]

// Test SET operation
arr :SET: (0, 10)
DEF first #int = arr :GET: (0)

// Test CONTAINS operation
DEF has_three #bool = arr :CONTAINS: (3)
DEF has_nine #bool = arr :CONTAINS: (9)

// Test INDEX_OF operation
DEF index_of_three #int = arr :INDEX_OF: (3)
DEF index_of_nine #int = arr :INDEX_OF: (9)

// Test SLICE operation
DEF slice_result #[#int] = arr :SLICE: (1, 4)

// Test SUM operation
DEF total #int = arr :SUM:()

// Test SORT operation
DEF unsorted #[#int] = [5, 2, 8, 1, 9]
unsorted :SORT:()
DEF sorted_first #int = unsorted :GET: (0)
